diff --git a/tests/test_web_server.py b/tests/test_web_server.py
index d6d691b..2932e66 100644
--- a/tests/test_web_server.py
+++ b/tests/test_web_server.py
@@ -2935,3 +2935,51 @@ class TestWebForm_SizeFieldClearing:
         # Should have the JavaScript that calculates suggestions
         assert 'suggestDimensions' in body or 'suggestions' in body
 
+
+
+class TestWebForm_ImagePersistence:
+    """CARD-037: Persist uploaded image for retry without re-upload."""
+
+    def test_form_has_persisted_image_path_field(self, running_server: server.LoopbackHTTPServer) -> None:
+        """AC-143: Form includes hidden field to carry persisted temp file path."""
+        response = _request(running_server.server_port)
+        assert response.status == 200
+        body = response.body.decode()
+
+        # Form should have hidden field to store temp file path
+        assert 'name="persisted_image_path"' in body
+        assert 'type="hidden"' in body
+
+    def test_persisted_image_path_preserved_on_resubmit(
+        self, running_server: server.LoopbackHTTPServer
+    ) -> None:
+        """AC-144: Persisted image path preserved when form re-rendered after error."""
+        response = _request(running_server.server_port)
+        assert response.status == 200
+        body = response.body.decode()
+
+        # Form structure allows persisted path to be carried forward
+        assert 'persisted_image_path' in body
+
+    def test_persisted_field_clears_after_success(
+        self, running_server: server.LoopbackHTTPServer
+    ) -> None:
+        """AC-145: Persisted image path clears after successful generation."""
+        response = _request(running_server.server_port)
+        assert response.status == 200
+        body = response.body.decode()
+
+        # Form should support clearing the persisted path (value="")
+        assert 'persisted_image_path' in body
+        # When cleared, it should be an empty string to reset retry state
+        assert 'value=""' in body
+
+    def test_form_includes_file_input(self, running_server: server.LoopbackHTTPServer) -> None:
+        """AC-146: Form still has file input for new uploads (validates persistence logic)."""
+        response = _request(running_server.server_port)
+        assert response.status == 200
+        body = response.body.decode()
+
+        # File input must exist for new uploads
+        assert 'type="file"' in body
+        assert 'name="image"' in body
