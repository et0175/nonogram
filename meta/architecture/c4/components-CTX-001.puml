title Components — Puzzle Creation Context (CTX-001)

Person(puzzleCreator, "Puzzle Creator", "ACT-001")

Container_Boundary(cliTool, "Puzzle Creation — CLI and web UI, one process (CTX-001)") {

  Component(cli, "COMP-001 CLI Adapter", "Python — cli.py", "Thin adapter (ADR-0007): stdlib argparse parses mode/size/density/difficulty/--out/--seed and expresses only syntactic constraints (ADR-0010); domain validation lives inward. Echoes the seed (ADR-0015) and prints the FR-014 nudge-count line. Contains no domain logic.")

  Component(web, "COMP-008 Web UI Adapter", "Python — web/ (stdlib http.server)", "Second inbound adapter (ADR-0019), a sibling of COMP-001 launched by `nonogram serve` from the same console entry point (ADR-0008) — so the same process and container, not a second one. Takes a form POST, makes the same synchronous call into COMP-002 the CLI makes (ADR-0021), and reports success or failure with the paths written. Binds loopback only and refuses cross-origin requests (NFR-003, NFR-004, CON-009, CON-010). No state beyond the export files (CON-017).")

  Component(orchestrator, "COMP-002 Pipeline Orchestrator", "Python — orchestrator.py", "Owns the Puzzle aggregate (AGG-001) and drives one generation run end to end. Sole enforcement point for INV-002 (export gate: uniqueness confirmed first) and INV-003 (retry/nudge counter bound, NFR-002/ADR-0002). Drives POL-001 regenerate, POL-002 pixel-nudge, POL-003 nudge-cap failure, POL-004 difficulty resample, POL-005 abandon-after-max-retries (EVT-012). Computes the ADR-0001 deadline and passes it into the solver; converts SolverTimeout into clean abandonment (ADR-0011). Injects the single random.Random instance (ADR-0015).")

  Component(sourcing, "COMP-003 Grid Sourcing", "Python — sourcing/", "CAP-001: produces a black/white solution grid in one of three modes — random at a configured size 10x10..50x50 and density (FR-001, FR-004, ±3pp tolerance per ADR-0003), built-in named library (FR-002: cat/house/heart/moon), or uploaded image resized then Floyd-Steinberg dithered (FR-003) via Pillow/NumPy (ADR-0006). Also applies the bounded pixel nudge on CMD-007. Stochastic paths draw from the injected Random (ADR-0015).")

  Component(clues, "COMP-004 Clue Derivation", "Python — clues.py", "CAP-002: run-length encodes every row and column of a solution grid into clue tuples (FR-005), including the [0] empty-line marker. Pure function; upholds INV-001 (clues always equal the RLE of the current grid). Boundary types per ADR-0012.")

  Component(solver, "COMP-005 Solver", "Python — solver/", "CAP-003: hand-rolled line solver (ADR-0009) — per-line clue-possibility propagation to a fixed point, then branching on the most-constrained unknown cell; fails fast the moment a second distinct solution appears (FR-006/AC-017). Reports solution_count (0/1/many) plus, from the same one solve: the first-fixed-point undecided mask and — on MANY — the second witness solution (FR-024, both list[list[bool]] at the boundary, EC-012), the structural signals (line-logic coverage, branch_nodes; elapsed time is a deadline fact, never a difficulty input — NFR-007/CON-014), and each settled cell's rung tag on the ladder simple_overlap < line_dp < cross_line < probe_contradiction (ADR-0029/R2, overlap masks re-derived natively per ADR-0007). Int-bitmask-per-line grid representation (ADR-0012). Cooperative deadline check at each fixed point and branch node, raising SolverTimeout (ADR-0011). PURE function of clues — no filesystem, no CLI, no I/O — so EC-001/CON-005 can be property-tested directly against a brute-force reference oracle (ADR-0014).")

  Component(difficulty, "COMP-006 Difficulty Scoring", "Python — difficulty.py", "CAP-004: derives the 0..100 score of a line-solvable puzzle from the solver's rung tags — the hardest rung required, then the share of cells settled at it (ADR-0029, replacing ADR-0013's weighted sum; FR-026) — and classifies with ONE function taking the score alone: the three bands Easy/Medium/Hard tile the whole scale (FR-008, FR-010, ADR-0005 cutoffs). ADR-0031 retired the fourth `guess` tier and EC-015 with it — branching is reported as a strategy, never as a difficulty. Emits the ordered strategies list — the rungs present, `guess` appended iff the search branched (FR-029, EC-017). No clock reading and no size/density term enters score, tier or list (NFR-007, CON-014, ADR-0029/R3). Heuristic bands, not a construction guarantee (CON-004).")

  Component(export, "COMP-007 Export Renderers", "Python — export/", "CAP-005: renders a finalized, uniqueness-confirmed puzzle as print-ready PNG/SVG (FR-011, Pillow per ADR-0006) or as JSON/CSV carrying the full solution grid, clues and seed (FR-012, ADR-0015), exactly round-trippable per EC-002. Also renders the FR-016 two-page PDF (page 1 blank puzzle + clues, page 2 answer key, both headered with the FR-015 name and difficulty tier) by reusing that same PNG raster path through Pillow's built-in multi-page PDF save — no new dependency (CON-006, ADR-0006). Resolves the export path as <name>-<difficulty>.pdf (ADR-0016), auto-suffixing on collision (ADR-0017). Static output only (CON-002). Invoked only after the orchestrator's INV-002 gate passes.")
}

Container_Boundary(adminPanel, "Admin Panel — separate process (CTX-001)") {

  Component(admin, "COMP-009 Admin Panel", "Python — admin/ (Flask)", "Third inbound adapter, deployed as its own process (Procfile; Render). Batch generation through COMP-002, human review and curation, re-grading, and book assembly and PDF export. Stores a puzzle only after its storage guard has re-derived the clues and had the solver prove it unique (ADR-0032/R1); an unmeasured quality score is unknown, never zero (ADR-0032/R2). Loopback-only by default, one credentialed door when ADMIN_ALLOWED_HOST is set (CON-015, CON-016, ADR-0030).")

  ComponentDb(persistence, "COMP-010 Persistence", "Python — db/ (SQLAlchemy, Alembic; Postgres)", "Batches, puzzles, books and generation history for the admin panel — the only persistent state in the system (CON-017). Its only caller is COMP-009. The schema also carries `users` and `user_selected_books`, which no code path reads or writes (CON-017; CARD-111 option B, undecided).")
}

System_Ext(filesystem, "Local Filesystem", "Source images in; exports out. Infrastructure, not an EXT-XXX.")

Rel(puzzleCreator, cli, "Runs `nonogram ...`", "argv")
Rel(cli, puzzleCreator, "Seed echo, nudge count (FR-014), failure messages", "stdout/stderr")
Rel(cli, orchestrator, "Calls with a validated generation request", "in-process call")
Rel(orchestrator, cli, "Returns run outcome: export paths, nudge count, abandonment reason", "return value")

Rel(orchestrator, sourcing, "Generate / regenerate candidate grid (CMD-001..CMD-003, CMD-006); nudge pixels (CMD-007)", "in-process call")
Rel(orchestrator, clues, "Compute row/column clues (CMD-004)", "in-process call")
Rel(orchestrator, solver, "Check uniqueness with deadline (CMD-005) — returns count, solution, undecided mask + second witness on MANY (FR-024), signals and rung tags (ADR-0029)", "in-process call")
Rel(orchestrator, difficulty, "Classify candidate from the score and rung tags (CMD-009) — one of three tiers, plus the strategies list; resample decision (CMD-010)", "in-process call")
Rel(orchestrator, export, "Export finalized puzzle (CMD-012, CMD-013) — only after the INV-002 gate", "in-process call")

Rel(puzzleCreator, web, "Fills in the generation form in a browser", "HTTP, loopback only")
Rel(cli, web, "`nonogram serve` launches it", "in-process call")
Rel(web, orchestrator, "Same synchronous generation call the CLI makes (ADR-0021)", "in-process call")

Rel(puzzleCreator, admin, "Reviews batches, curates puzzles, assembles books", "HTTP; credential when remote (ADR-0030)")
Rel(admin, orchestrator, "Generates batches and single puzzles (generate, generate_batch)", "in-process call")
Rel(admin, sourcing, "Fits uploaded pictures: ink box, crop, extent prediction", "in-process call")
Rel(admin, clues, "Re-derives clues at the storage boundary (ADR-0032/R1)", "in-process call")
Rel(admin, solver, "Proves uniqueness before storing; re-grades stored puzzles (ADR-0032/R1)", "in-process call")
Rel(admin, difficulty, "Scores and classifies on re-grade", "in-process call")
Rel(admin, export, "Renders puzzle pages for book PDFs", "in-process call")
Rel(admin, persistence, "Reads and writes batches, puzzles, books", "SQLAlchemy session")
Rel(admin, filesystem, "Stores uploaded pictures, and reads them back to generate", "local file I/O")
Rel(admin, puzzleCreator, "Book PDFs, streamed as downloads — never written to disk", "HTTP (send_file)")

Rel(sourcing, filesystem, "Reads uploaded source image (FR-003)", "Pillow")
Rel(export, filesystem, "Writes PNG/SVG/JSON/CSV/PDF", "local file I/O")

SHOW_LEGEND()
@enduml
