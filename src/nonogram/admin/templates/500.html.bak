{% extends "base.html" %}

{% block title %}500 Server Error - Nonogram Admin{% endblock %}

{% block content %}
<div class="row" style="margin-top: 100px;">
    <div class="col-md-6 mx-auto text-center">
        <h1 style="font-size: 4rem; color: #e74c3c;">500</h1>
        <h2>Server Error</h2>
        <p class="text-muted mb-2">An internal server error occurred.</p>
        {% if error %}
        <div class="alert alert-danger mt-3" style="text-align: left;">
            <strong>Error:</strong> {{ error }}
        </div>
        {% endif %}
        <a href="/" class="btn btn-primary">← Back to Dashboard</a>
    </div>
</div>
{% endblock %}
