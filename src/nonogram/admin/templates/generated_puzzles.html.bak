{% extends "base.html" %}

{% block title %}Generated Puzzles - Nonogram Admin{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-12">
        <h1>✅ Generated Puzzles</h1>
        <p class="text-muted">Preview and download your generated nonogram puzzles</p>
    </div>
</div>

<div class="row">
    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Generated Puzzle Grids ({{ puzzles|length }})</h5>
            </div>
            <div class="card-body">
                {% if puzzles %}
                    <div class="row">
                        {% for puzzle in puzzles %}
                        <div class="col-md-6 mb-4">
                            <div class="card border">
                                <div class="card-body">
                                    <!-- Puzzle SVG Grid -->
                                    <div class="puzzle-preview-box mb-3">
                                        <img src="/api/puzzle/{{ puzzle.id }}/grid"
                                             alt="Puzzle {{ puzzle.id }}"
                                             class="puzzle-grid-img"
                                             onerror="this.parentElement.innerHTML='<div class=placeholder-content><div class=preview-icon>⚠️</div><div class=preview-dims>Failed to load grid</div></div>'">
                                    </div>

                                    <!-- Download Buttons -->
                                    <div class="mb-3">
                                        <div class="btn-group w-100" role="group">
                                            <a href="/api/puzzle/{{ puzzle.id }}/grid/download"
                                               class="btn btn-sm btn-outline-primary"
                                               download>
                                                ⬇️ SVG
                                            </a>
                                            <a href="/api/puzzle/{{ puzzle.id }}/grid/download-pdf"
                                               class="btn btn-sm btn-outline-success"
                                               download>
                                                📄 PDF
                                            </a>
                                        </div>
                                    </div>

                                    <!-- Puzzle Info -->
                                    <div class="puzzle-info">
                                        <div class="row mb-2">
                                            <div class="col-6">
                                                <small><strong>Size:</strong></small><br>
                                                <small>{{ puzzle.get('width', '?') }}×{{ puzzle.get('height', '?') }}</small>
                                            </div>
                                            <div class="col-6">
                                                <small><strong>Difficulty:</strong></small><br>
                                                <small>{{ puzzle.get('difficulty_tier', 'N/A') }}</small>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-6">
                                                <small><strong>Quality:</strong></small><br>
                                                <small>{{ (puzzle.get('quality_score', 0)|int) }}/100</small>
                                            </div>
                                            <div class="col-6">
                                                <small><strong>Source:</strong></small><br>
                                                <small>{{ puzzle.get('source_image', 'N/A') }}</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="action-buttons" data-puzzle-id="{{ puzzle.id }}">
                                        <form method="POST" action="/puzzle/{{ puzzle.id }}/approve?batch_id={{ batch_id }}" class="puzzle-action-form" data-action="approve" style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-success puzzle-action-btn" title="Approve this puzzle">
                                                ✓ Approve
                                            </button>
                                        </form>
                                        <form method="POST" action="/puzzle/{{ puzzle.id }}/reject?batch_id={{ batch_id }}" class="puzzle-action-form" data-action="reject" style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-danger puzzle-action-btn" title="Reject this puzzle">
                                                ✕ Reject
                                            </button>
                                        </form>
                                        <span class="puzzle-status-badge ms-2"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        No puzzles were generated. This might be due to quality filter or processing errors.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-md-3">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Summary</h5>
            </div>
            <div class="card-body">
                <strong>Generated:</strong><br>
                <span class="badge bg-success">{{ puzzles|length }} puzzle(s)</span>

                {% if total_images > 0 and filtered_count > 0 %}
                <br><small class="text-muted mt-2 d-block">
                    from {{ total_images }} image(s)<br>
                    <strong>{{ filtered_count }} filtered out</strong> by quality threshold
                </small>
                {% elif total_images > 0 %}
                <br><small class="text-muted mt-2 d-block">
                    from {{ total_images }} image(s)
                </small>
                {% endif %}

                <hr>

                <strong>Batch ID:</strong><br>
                <code style="font-size: 0.85rem;">{{ batch_id }}</code>

                <hr>

                <div class="alert alert-light text-center mb-0">
                    <small class="text-muted">
                        ✅ Generation complete!<br>
                        Review and download your puzzles.
                    </small>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="card-title mb-0">Navigation</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/batch/create" class="btn btn-primary">
                        ➕ Create New Batch
                    </a>
                    <a href="/" class="btn btn-outline-secondary">
                        🏠 Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.puzzle-preview-box {
    width: 200px;
    height: 200px;
    max-width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border: 2px solid #b0bec5;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
}

.puzzle-grid-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
}

.placeholder-content {
    text-align: center;
    color: #555;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.preview-icon {
    font-size: 3rem;
}

.preview-dims {
    font-size: 0.85rem;
    font-weight: 700;
    color: #333;
}

.puzzle-info {
    background-color: #f8f9fa;
    padding: 12px;
    border-radius: 6px;
    font-size: 0.9rem;
}

.action-buttons {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.action-buttons form {
    flex: 1;
    min-width: 80px;
}

.action-buttons .btn {
    width: 100%;
}

.puzzle-status-badge {
    white-space: nowrap;
    display: inline-block;
    vertical-align: middle;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Handle approve/reject with visual feedback
    document.querySelectorAll('.puzzle-action-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const action = this.dataset.action;
            const actionBtn = this.querySelector('.puzzle-action-btn');
            const container = this.closest('[data-puzzle-id]');
            const statusBadge = container.querySelector('.puzzle-status-badge');

            // Confirm reject action
            if (action === 'reject' && !confirm('Reject this puzzle?')) {
                return;
            }

            // Disable button and show loading state
            actionBtn.disabled = true;
            const originalText = actionBtn.textContent;
            actionBtn.textContent = '⏳...';

            // Submit form
            fetch(this.action, {
                method: 'POST'
            })
            .then(response => {
                // Update UI with status badge
                if (action === 'approve') {
                    statusBadge.innerHTML = '<span class="badge bg-success ms-2">✓ Approved</span>';
                } else if (action === 'reject') {
                    statusBadge.innerHTML = '<span class="badge bg-danger ms-2">✕ Rejected</span>';
                }

                // Disable both buttons
                container.querySelectorAll('.puzzle-action-btn').forEach(btn => {
                    btn.disabled = true;
                    btn.style.opacity = '0.6';
                });

                // Show success message
                console.log(`Puzzle ${action}ed successfully`);
            })
            .catch(error => {
                // Restore button
                actionBtn.disabled = false;
                actionBtn.textContent = originalText;
                statusBadge.innerHTML = `<span class="badge bg-danger">Error</span>`;
                console.error('Error:', error);
            });
        });
    });
});
</script>

{% endblock %}
