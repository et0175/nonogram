{% extends "base.html" %}

{% block title %}{{ book.metadata.title }} - Nonogram Admin{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-8">
        <h1>{{ book.metadata.title }}</h1>
        <p class="text-muted">{{ book.metadata.description }}</p>
    </div>
    <div class="col-md-4 text-end">
        <span class="badge badge-{{ book.status|replace('_', '-') }}" style="font-size: 1rem;">
            {{ book.status|replace('_', ' ')|title }}
        </span>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Book Details</h5>
            </div>
            <div class="card-body">
                <table class="table">
                    <tr>
                        <td><strong>Book ID</strong></td>
                        <td><code>{{ book.book_id }}</code></td>
                    </tr>
                    <tr>
                        <td><strong>Theme</strong></td>
                        <td>{{ book.metadata.theme|capitalize }}</td>
                    </tr>
                    <tr>
                        <td><strong>Audience</strong></td>
                        <td>{{ book.metadata.target_audience }}</td>
                    </tr>
                    <tr>
                        <td><strong>Size</strong></td>
                        <td>{{ book.metadata.size }}</td>
                    </tr>
                    <tr>
                        <td><strong>Puzzles</strong></td>
                        <td>{{ book.puzzle_ids|length }}</td>
                    </tr>
                    <tr>
                        <td><strong>Pages</strong></td>
                        <td>{{ book.metadata.page_count }}</td>
                    </tr>
                    <tr>
                        <td><strong>Created</strong></td>
                        <td>{{ book.created_at.strftime('%Y-%m-%d %H:%M') }}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Status & Actions</h5>
            </div>
            <div class="card-body">
                <form method="POST" action="/book/{{ book.book_id }}/status" class="mb-3">
                    <label for="status" class="form-label">Update Status</label>
                    <select class="form-select" id="status" name="status" required>
                        <option value="draft" {% if book.status == 'draft' %}selected{% endif %}>Draft</option>
                        <option value="ready_for_pdf" {% if book.status == 'ready_for_pdf' %}selected{% endif %}>Ready for PDF</option>
                        <option value="pdf_generated" {% if book.status == 'pdf_generated' %}selected{% endif %}>PDF Generated</option>
                        <option value="ready_for_kdp" {% if book.status == 'ready_for_kdp' %}selected{% endif %}>Ready for KDP</option>
                        <option value="published" {% if book.status == 'published' %}selected{% endif %}>Published</option>
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm mt-2">Update Status</button>
                </form>

                <hr>

                <h6>PDF Generation</h6>
                {% if book.puzzle_ids|length > 0 %}
                <form method="POST" action="/book/{{ book.book_id }}/generate-pdf" style="display:inline;">
                    <button type="submit" class="btn btn-success btn-sm w-100">📥 Generate & Download PDF</button>
                </form>
                {% else %}
                <button class="btn btn-success btn-sm w-100" disabled>
                    📥 Generate PDF (add puzzles first)
                </button>
                {% endif %}

                <hr>

                {% if book.metadata.pdf_url %}
                <p>📄 <strong>Last Generated:</strong> {{ book.metadata.pdf_url }}</p>
                {% endif %}

                {% if book.metadata.kdp_asin %}
                <p>📦 <strong>ASIN:</strong> {{ book.metadata.kdp_asin }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Puzzles ({{ book.puzzle_ids|length }})</h5>
            </div>
            <div class="card-body">
                {% if book.puzzle_ids %}
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Position</th>
                                <th>Puzzle ID</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for puzzle_id in book.puzzle_ids %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td><code>{{ puzzle_id }}</code></td>
                                <td>
                                    <form action="/book/{{ book.book_id }}/remove-puzzle" method="POST" style="display:inline;">
                                        <input type="hidden" name="puzzle_id" value="{{ puzzle_id }}">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Remove this puzzle?')">Remove</button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <p class="text-muted">No puzzles in this book yet.</p>
                {% endif %}

                <hr>

                <h6>Add Puzzles to Book</h6>
                <form method="POST" action="/book/{{ book.book_id }}/add-puzzles">
                    <div class="mb-3">
                        <label for="puzzle_ids" class="form-label">Puzzle IDs (comma-separated)</label>
                        <textarea class="form-control" id="puzzle_ids" name="puzzle_ids" rows="3"
                                  placeholder="e.g., puzzle_000001, puzzle_000002, puzzle_000003"></textarea>
                        <small class="form-text text-muted">Enter puzzle IDs separated by commas</small>
                    </div>
                    <button type="submit" class="btn btn-primary">➕ Add Puzzles</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <a href="/books" class="btn btn-outline-secondary">← Back to Books</a>
    </div>
</div>
{% endblock %}
