{% extends "base.html" %}

{% block title %}Select Images - Nonogram Admin{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-12">
        <h1>Batch: Select Images</h1>
        <p class="text-muted">Review and manage images before generating puzzles</p>
    </div>
</div>

<div class="row">
    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Selected Images</h5>
            </div>
            <div class="card-body">
                {% if images %}
                <div class="row mb-3">
                    <div class="col-md-8">
                        <button class="btn btn-sm btn-outline-secondary" onclick="clearAll()">
                            🗑️ Clear All
                        </button>
                        <span class="text-muted ms-3">
                            {{ images|length }} image{{ images|length != 1 and 's' or '' }} selected
                            ({{ total_size_mb|round(2) }} MB)
                        </span>
                    </div>
                    <div class="col-md-4">
                        <div class="btn-group btn-group-sm float-end" role="group">
                            <input type="radio" class="btn-check" name="defaultSize" id="size-small" value="small" onchange="applyDefaultSize('small')">
                            <label class="btn btn-outline-secondary" for="size-small">S</label>

                            <input type="radio" class="btn-check" name="defaultSize" id="size-medium" value="medium" onchange="applyDefaultSize('medium')" checked>
                            <label class="btn btn-outline-secondary" for="size-medium">M</label>

                            <input type="radio" class="btn-check" name="defaultSize" id="size-large" value="large" onchange="applyDefaultSize('large')">
                            <label class="btn btn-outline-secondary" for="size-large">L</label>
                        </div>
                    </div>
                </div>

                <div class="image-grid">
                    {% for image in images %}
                    <div class="image-item" data-file-id="{{ image.file_id }}">
                        <div class="image-preview">
                            <img src="/api/image/{{ image.file_id }}"
                                 alt="{{ image.original_filename }}"
                                 class="preview-img"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="placeholder-content" style="display:none;">
                                <div class="preview-icon">🖼️</div>
                                <div class="preview-dims">{{ image.dimensions[0] }}×{{ image.dimensions[1] }}</div>
                                <div class="preview-format">{{ image.format }}</div>
                            </div>
                        </div>
                        <div class="image-info">
                            <div class="filename" title="{{ image.original_filename }}">
                                {{ image.original_filename|truncate(20, true, '') }}...
                            </div>
                            <div class="meta">
                                {{ image.format }} • {{ (image.file_size / 1024)|round(0)|int }}KB
                            </div>
                        </div>
                        <button class="btn-remove" onclick="removeImage('{{ image.file_id }}')" title="Remove image">
                            ×
                        </button>
                    </div>
                    {% endfor %}
                </div>

                <hr>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <button class="btn btn-outline-secondary w-100" onclick="addMoreImages()">
                            ➕ Add More Images
                        </button>
                    </div>
                    <div class="col-md-6">
                        <a href="/batch/create" class="btn btn-outline-secondary w-100">
                            ◄ Back to Selection
                        </a>
                    </div>
                </div>

                {% else %}
                <div class="alert alert-info text-center py-5">
                    <p>📷 No images selected yet</p>
                    <p class="text-muted mb-3">Go back and upload or select images from a directory</p>
                    <a href="/batch/create" class="btn btn-primary">◄ Back to Selection</a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Info</h5>
            </div>
            <div class="card-body">
                <strong>Images Selected:</strong><br>
                <span class="badge bg-primary">{{ images|length }}</span>

                <hr>

                <strong>Total Size:</strong><br>
                {{ total_size_mb|round(2) }} MB
                <br><small class="text-muted">(Max 2MB per image)</small>

                <hr>

                <strong>Formats:</strong><br>
                <small>
                    PNG, JPG, GIF
                </small>

                <hr>

                <div class="alert alert-light text-center mb-0">
                    <small class="text-muted">
                        Next: Preview sizes and configure
                        puzzle generation options
                    </small>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5 class="card-title mb-0">Next Step</h5>
            </div>
            <div class="card-body">
                {% if images %}
                <form method="POST" action="/batch/preview-images">
                    <input type="hidden" name="image_ids" value="{{ image_ids|join(',') }}">
                    <button type="submit" class="btn btn-primary w-100">
                        Next: Configure Sizes ➡️
                    </button>
                </form>
                {% else %}
                <button class="btn btn-primary w-100" disabled>
                    Select Images First
                </button>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
.image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 15px;
    padding: 10px 0;
}

.image-item {
    position: relative;
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s;
}

.image-item:hover {
    border-color: #007bff;
    box-shadow: 0 2px 8px rgba(0, 123, 255, 0.2);
}

.image-preview {
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f9fa;
    font-size: 2rem;
    overflow: hidden;
    border: 2px solid #ddd;
    border-radius: 4px;
    position: relative;
}

.image-preview.preview-placeholder {
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border-color: #b0bec5;
    border-style: dashed;
}

.preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.placeholder {
    text-align: center;
}

.placeholder-content {
    text-align: center;
    color: #555;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
}

.preview-icon {
    font-size: 2.5rem;
}

.preview-dims {
    font-size: 0.75rem;
    font-weight: 600;
    color: #333;
}

.preview-format {
    font-size: 0.6rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.dimensions {
    font-size: 0.65rem;
    color: #666;
    margin-top: 5px;
}

.image-info {
    padding: 8px;
    font-size: 0.75rem;
}

.filename {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
}

.meta {
    color: #999;
    font-size: 0.7rem;
}

.btn-remove {
    position: absolute;
    top: 2px;
    right: 2px;
    background: rgba(220, 53, 69, 0.9);
    color: white;
    border: none;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    padding: 0;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s;
}

.image-item:hover .btn-remove {
    opacity: 1;
}

.btn-remove:hover {
    background: rgba(220, 53, 69, 1);
}
</style>

<script>
function applyDefaultSize(size) {
    // Map size presets to actual sizes
    const sizes = {
        'small': { mode: 'fixed', value: 15 },
        'medium': { mode: 'fixed', value: 20 },
        'large': { mode: 'fixed', value: 25 }
    };

    const config = sizes[size] || sizes['medium'];
    console.log('Default size preset:', size, '→', config);
    // This will be applied when user goes to next step
}

function removeImage(fileId) {
    if (!confirm('Remove this image?')) return;

    // TODO: CARD-004p - Implement image removal via API
    console.log('Removing image:', fileId);
    location.reload();  // Placeholder - will be replaced with AJAX
}

function addMoreImages() {
    // TODO: CARD-004p - Add more images via form
    alert('TODO: Add more images functionality');
}

function clearAll() {
    if (!confirm('Remove all images?')) return;

    // TODO: CARD-004p - Clear all images via API
    console.log('Clearing all images');
    location.reload();  // Placeholder
}
</script>
{% endblock %}
